# Copy to .env and adjust. Every value here has a working default; this file
# exists to document what can be changed, not because anything is required.

# --- local LLM (triage, attack-surface analysis, CTF assistance) ---
# Ollama runs on the host, not in a container. Scans work without it; you lose
# the AI triage pass and the attack-surface leads.
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- detection content ---
# Templates, fingerprints and tool binaries refresh every 24 hours. Set to 0
# to update only when you press the button.
MERLON_AUTO_UPDATE=1

# --- rate ceilings ---
# A scan may request less than these, never more. This is what stops a
# mistyped profile from turning a scan into a denial of service.
MERLON_MAX_RATE_LIMIT=150
MERLON_MAX_CONCURRENCY=25
MERLON_MAX_CONCURRENT_SCANS=2
